import { Button, ComboBox, Slider, Switch, LineEdit, TextEdit, ScrollView, Palette } from "std-widgets.slint";

// A plain rounded container with an optional title - std-widgets' GroupBox
// in this style has no background/border/radius at all (just a title Text
// floating over an invisible Rectangle), which is most of why the app
// looked bare. This is the main visual upgrade: every panel below is one of
// these instead.
component Card inherits Rectangle {
    in property <string> title: "";
    // Custom components don't automatically inherit a settable `enabled`
    // from their root element the way built-in/std-widget ones do, so it
    // has to be declared explicitly here. Used to dim the whole card rather
    // than actually blocking input - the underlying GroupBox this replaces
    // never blocked input either (its own `enabled` only ever tinted the
    // title text), and every Rust action already handles "not connected"
    // gracefully on its own.
    in property <bool> enabled: true;
    background: Palette.alternate-background;
    border-radius: 12px;
    opacity: root.enabled ? 1.0 : 0.55;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        if root.title != "": Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: Palette.foreground;
        }

        @children
    }
}

// A segmented-control-style option button (ANC mode, Crossfeed level) -
// filled with the accent color when selected, otherwise a plain control
// background. Meant to be used 2-4 at a time in a HorizontalLayout with
// `horizontal-stretch: 1` on each.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: 8px;
    background: root.selected ? Palette.accent-background : Palette.control-background;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        color: root.selected ? Palette.accent-foreground : Palette.control-foreground;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Small muted label, for secondary/status text under a card's main controls.
component Caption inherits Text {
    color: Palette.foreground.with-alpha(0.6);
    font-size: 12px;
    wrap: word-wrap;
}

// One entry in `paired-devices` below - mirrors `commands::PairedDevice` in
// gui/src/main.rs.
export struct PairedDeviceInfo {
    name: string,
    connected: bool,
}

export component AppWindow inherits Window {
    title: "Sennheiser Controls";
    preferred-width: 980px;
    preferred-height: 760px;
    background: Palette.background;

    // Force dark mode regardless of the system theme - this app's whole
    // visual design (Card/PillButton colors above) is built around it, and
    // every std-widget here (Switch, Slider, ComboBox, etc) reads the same
    // Palette internally, so this alone reskins them consistently too.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // --- Device state, set from Rust ---
    in property <[string]> device-names: [];
    in-out property <int> selected-device-index: -1;
    in property <bool> gaia-connected: false;
    in property <string> connection-status: "Not connected";
    in property <string> transport-kind: "classic"; // "classic" | "ble"

    in property <string> volume-text: "-";
    // in-out + `<=>` below rather than a one-way `value: root.volume-value`
    // binding: the Slider's own drag/keyboard handling writes to its `value`
    // property directly, which would otherwise permanently sever a one-way
    // binding the first time the user drags it, leaving the slider stuck and
    // no longer reflecting volume changes made via the +/-/Refresh buttons.
    // A two-way alias keeps them as a single shared value instead.
    in-out property <float> volume-value: 0;
    in property <string> battery-text: "-";

    in property <[string]> eq-preset-names: [];
    // Set from Rust when the live band-1-4 snapshot (see
    // spawn_gaia_notification_listener in gui/src/main.rs) uniquely matches
    // a known preset's bands 1-4 - band 0 isn't reported by that push, so
    // this is a best-effort fingerprint match, not a real "get current
    // preset" query (no such opcode is known). Left alone (not reset to 0)
    // when a live update doesn't match anything, so it doesn't fight the
    // combo box the user is actively choosing from.
    in-out property <int> eq-preset-index: 0;
    // Five discrete properties rather than one `[int]` array: like
    // volume-value above, each band's Slider needs a two-way `<=>` binding
    // so drags and preset/Rust-driven updates share one storage cell
    // instead of a one-way binding that a drag would sever. Two-way
    // bindings alias a plain property path, not an array-index expression,
    // hence one property per band rather than `eq-band-gains[i]`.
    in-out property <float> eq-band-0: 0;
    in-out property <float> eq-band-1: 0;
    in-out property <float> eq-band-2: 0;
    in-out property <float> eq-band-3: 0;
    in-out property <float> eq-band-4: 0;
    // dB-formatted display text for each band above, computed in Rust (see
    // eq_gain_db_label in gui/src/main.rs) - a raw/10 scale that isn't worth
    // reimplementing in Slint expressions just for the sign/decimal formatting.
    in property <string> eq-band-0-label: "0.0dB";
    in property <string> eq-band-1-label: "0.0dB";
    in property <string> eq-band-2-label: "0.0dB";
    in property <string> eq-band-3-label: "0.0dB";
    in property <string> eq-band-4-label: "0.0dB";

    // Auto-queried on connect via each command's explicit "get" opcode (ANC's
    // is unverified - see core/src/gaia.rs docs - so its text is
    // best-effort; Multipoint's is verified). This is separate from, and
    // older than, the live push-notification feed below: right after
    // connecting, Rust also registers this connection for live state
    // updates (`commands::register_for_live_status`) - without that
    // explicit step the headset pushes nothing at all, ever. Once
    // registered, it pushes the current value immediately and again on
    // every later change (including from its own physical buttons), which
    // is what keeps anc-selected/noise-control-percent/bass-boost-on/
    // anti-wind-on/multipoint-on updated live from Rust from here on - see
    // `spawn_gaia_notification_listener` in gui/src/main.rs.
    in property <string> anc-status-text: "unknown";
    in property <string> multipoint-status-text: "unknown";
    // The headset's own paired-device list, by name - distinct from
    // multipoint-status-text above, which only reports a currently-connected
    // COUNT. UNVERIFIED opcode (0x1400/0x1401) - see
    // gaia::CMD_SONOVA_PAIRED_DEVICE_GET docs, particularly around what
    // `connected` really means.
    in property <[PairedDeviceInfo]> paired-devices: [];

    // --- Device info + "more settings", from the third-party protocol
    // writeup (see core/src/gaia.rs doc comments) - UNVERIFIED opcodes,
    // though all of these round-tripped correctly in live testing except
    // Audio Mode and Prompt Language SET, which are deliberately left out
    // of this UI entirely (CLI-only, see `commands::set_audio_mode`/
    // `set_prompt_language` docs).
    in property <string> device-info-text: "Not queried yet.";
    callback refresh-device-info();

    in-out property <bool> smart-pause-on: false;
    in-out property <bool> on-head-detection-on: false;
    in-out property <bool> auto-answer-on: false;
    in-out property <bool> comfort-call-on: false;
    in-out property <bool> low-latency-on: false;
    in-out property <bool> bt-compatibility-on: false;
    in-out property <bool> voice-prompt-on: false;
    in-out property <float> sidetone-level: 0;
    in-out property <float> auto-power-off-seconds: 900;
    callback smart-pause-set(bool);
    callback on-head-detection-set(bool);
    callback auto-answer-set(bool);
    callback comfort-call-set(bool);
    callback low-latency-set(bool);
    callback bt-compatibility-set(bool);
    callback voice-prompt-set(bool);
    callback sidetone-set(int);
    callback auto-power-off-set(int);
    callback refresh-more-settings();

    // ANC/Transparency crossfade slider, revealed by the ANC panel's
    // "Custom" button. Two-way bound like volume-value/eq-band-* above so
    // drags and any future external update (from a click here, or a live
    // push notification) stay in sync.
    in-out property <float> noise-control-percent: 50;
    // `in-out`, not local UI state: the live notification listener reveals
    // this automatically when the headset reports its physical
    // ANC/Transparency button engaging Custom mode.
    in-out property <bool> anc-custom-visible: false;
    // Which ANC button is highlighted ("off" / "adaptive" / "custom" / "" =
    // none yet). `in-out`: driven both by local button clicks and by live
    // push notifications reflecting the device's actual current mode,
    // including changes made via the headset's own physical buttons.
    in-out property <string> anc-selected: "";

    // Which Crossfeed button is highlighted ("off" / "low" / "high" / "" =
    // not yet queried). `in-out`, same reasoning as anc-selected: driven by
    // local clicks, the connect-time status query, and (if it's ever
    // confirmed to push live - see gaia::RSP_SONOVA_CROSSFEED_GET docs) the
    // notification listener too.
    in-out property <string> crossfeed-selected: "";

    function leave-custom-anc() {
        root.anc-custom-visible = false;
        // Anti-wind only makes sense alongside the custom crossfade - force
        // it off whenever Custom mode is left, whether via its own button
        // or by picking Off/Adaptive instead.
        root.anti-wind-on = false;
        root.anti-wind-set(false);
    }

    // Toggle state for the switch-style controls. None of these have an
    // explicit "get" opcode, but all three are kept in sync with the device
    // via the live push-notification feed (see the comment on
    // anc-status-text above) in addition to reflecting whatever was last
    // sent from this UI.
    in-out property <bool> bass-boost-on: false;
    in-out property <bool> anti-wind-on: false;
    in-out property <bool> multipoint-on: false;

    // --- Callbacks into Rust ---
    callback refresh-devices();
    callback device-selected(int);
    callback set-transport(string);
    callback connect-gaia();
    callback disconnect-gaia();

    callback refresh-volume();
    callback set-volume(int);
    callback volume-step(int);
    callback refresh-battery-bluez();
    callback refresh-battery-btleplug();

    callback anc-status();
    callback anc-set(bool);
    callback bass-boost-set(bool);
    callback eq-preset-apply(string);
    callback crossfeed-set(string);
    callback anti-wind-set(bool);
    callback multipoint-set(bool);
    callback multipoint-status();
    callback refresh-paired-devices();
    callback noise-control-apply(int);
    callback raw-gaia-send(string, string, string, string);

    in-out property <string> log-text: "";

    // Pure UI state, never touched from Rust - just collapses the raw-GAIA
    // and log panels out of the way for normal use.
    property <bool> advanced-visible: false;

    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: start;

            Card {
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox {
                        model: root.device-names;
                        current-index <=> root.selected-device-index;
                        selected(value) => { root.device-selected(root.selected-device-index); }
                    }
                    Button { text: "Refresh"; clicked => { root.refresh-devices(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Transport:"; vertical-alignment: center; color: Palette.foreground; }
                    PillButton {
                        text: "Classic";
                        selected: root.transport-kind == "classic";
                        width: 80px;
                        clicked => { root.set-transport("classic"); }
                    }
                    PillButton {
                        text: "BLE";
                        selected: root.transport-kind == "ble";
                        width: 60px;
                        clicked => { root.set-transport("ble"); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: root.gaia-connected ? "Disconnect" : "Connect";
                        clicked => {
                            if (root.gaia-connected) {
                                root.disconnect-gaia();
                            } else {
                                root.connect-gaia();
                            }
                        }
                    }
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        y: (parent.height - self.height) / 2;
                        background: root.gaia-connected ? #4ade80 : #6b7280;
                    }
                    Text { text: root.connection-status; vertical-alignment: center; color: Palette.foreground; }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Card {
                    title: "Volume";
                    horizontal-stretch: 1;
                    Text { text: root.volume-text; color: Palette.foreground; }
                    Slider {
                        minimum: 0;
                        maximum: 127;
                        value <=> root.volume-value;
                        changed(value) => { root.set-volume(round(value)); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "-8"; clicked => { root.volume-step(-8); } }
                        Button { text: "+8"; clicked => { root.volume-step(8); } }
                        Button { text: "Refresh"; clicked => { root.refresh-volume(); } }
                    }
                }

                Card {
                    title: "Battery";
                    horizontal-stretch: 1;
                    Text { text: root.battery-text; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Refresh (bluez)"; clicked => { root.refresh-battery-bluez(); } }
                        Button { text: "Refresh (btleplug)"; clicked => { root.refresh-battery-btleplug(); } }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Card {
                    title: "ANC";
                    enabled: root.gaia-connected;
                    horizontal-stretch: 2;
                    Caption { text: "Last read (unverified): " + root.anc-status-text; }
                    HorizontalLayout {
                        spacing: 8px;
                        PillButton {
                            text: "Off";
                            selected: root.anc-selected == "off";
                            horizontal-stretch: 1;
                            clicked => {
                                root.anc-selected = "off";
                                root.leave-custom-anc();
                                root.anc-set(false);
                            }
                        }
                        PillButton {
                            text: "Adaptive";
                            selected: root.anc-selected == "adaptive";
                            horizontal-stretch: 1;
                            clicked => {
                                root.anc-selected = "adaptive";
                                root.leave-custom-anc();
                                root.anc-set(true);
                            }
                        }
                        PillButton {
                            text: "Custom";
                            selected: root.anc-selected == "custom";
                            horizontal-stretch: 1;
                            clicked => {
                                if (root.anc-custom-visible) {
                                    root.anc-selected = "";
                                    root.leave-custom-anc();
                                } else {
                                    root.anc-custom-visible = true;
                                    root.anc-selected = "custom";
                                    // Matches the official app: entering
                                    // Custom lands the crossfade at 50
                                    // (neutral) and turns Anti-wind on,
                                    // applied immediately rather than left
                                    // as a dangling local UI change.
                                    root.noise-control-percent = 50;
                                    root.noise-control-apply(50);
                                    root.anti-wind-on = true;
                                    root.anti-wind-set(true);
                                }
                            }
                        }
                    }
                    Button { text: "Status"; clicked => { root.anc-status(); } }
                    if root.anc-custom-visible: VerticalLayout {
                        spacing: 10px;
                        Caption { text: "Custom crossfade: 0 = full ANC, 100 = full Transparency"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Slider { minimum: 0; maximum: 100; value <=> root.noise-control-percent; }
                            Button { text: "Apply"; clicked => { root.noise-control-apply(round(root.noise-control-percent)); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Anti-wind:"; vertical-alignment: center; color: Palette.foreground; }
                            Switch {
                                text: root.anti-wind-on ? "On" : "Off";
                                checked <=> root.anti-wind-on;
                                toggled => { root.anti-wind-set(root.anti-wind-on); }
                            }
                        }
                    }
                }

                Card {
                    title: "Bass Boost";
                    enabled: root.gaia-connected;
                    horizontal-stretch: 1;
                    Switch {
                        text: root.bass-boost-on ? "On" : "Off";
                        checked <=> root.bass-boost-on;
                        toggled => { root.bass-boost-set(root.bass-boost-on); }
                    }
                }
            }

            Card {
                title: "Equalizer";
                enabled: root.gaia-connected;
                HorizontalLayout {
                    spacing: 10px;
                    preset-combo := ComboBox {
                        model: root.eq-preset-names;
                        current-index <=> root.eq-preset-index;
                    }
                    Button {
                        text: "Apply Preset";
                        clicked => { root.eq-preset-apply(preset-combo.current-value); }
                    }
                }
                // Read-only: bands only change via a preset (or a live
                // push - see spawn_gaia_notification_listener in
                // gui/src/main.rs), never by dragging directly.
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "50Hz:"; vertical-alignment: center; width: 60px; color: Palette.foreground; }
                    Slider { enabled: false; minimum: -32; maximum: 40; value <=> root.eq-band-0; }
                    Text { text: root.eq-band-0-label; vertical-alignment: center; width: 55px; color: Palette.foreground; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "250Hz:"; vertical-alignment: center; width: 60px; color: Palette.foreground; }
                    Slider { enabled: false; minimum: -32; maximum: 40; value <=> root.eq-band-1; }
                    Text { text: root.eq-band-1-label; vertical-alignment: center; width: 55px; color: Palette.foreground; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "800Hz:"; vertical-alignment: center; width: 60px; color: Palette.foreground; }
                    Slider { enabled: false; minimum: -32; maximum: 40; value <=> root.eq-band-2; }
                    Text { text: root.eq-band-2-label; vertical-alignment: center; width: 55px; color: Palette.foreground; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "3kHz:"; vertical-alignment: center; width: 60px; color: Palette.foreground; }
                    Slider { enabled: false; minimum: -32; maximum: 40; value <=> root.eq-band-3; }
                    Text { text: root.eq-band-3-label; vertical-alignment: center; width: 55px; color: Palette.foreground; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "8kHz:"; vertical-alignment: center; width: 60px; color: Palette.foreground; }
                    Slider { enabled: false; minimum: -32; maximum: 40; value <=> root.eq-band-4; }
                    Text { text: root.eq-band-4-label; vertical-alignment: center; width: 55px; color: Palette.foreground; }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Card {
                    title: "Crossfeed";
                    enabled: root.gaia-connected;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        PillButton {
                            text: "Off";
                            selected: root.crossfeed-selected == "off";
                            horizontal-stretch: 1;
                            clicked => { root.crossfeed-selected = "off"; root.crossfeed-set("off"); }
                        }
                        PillButton {
                            text: "Low";
                            selected: root.crossfeed-selected == "low";
                            horizontal-stretch: 1;
                            clicked => { root.crossfeed-selected = "low"; root.crossfeed-set("low"); }
                        }
                        PillButton {
                            text: "High";
                            selected: root.crossfeed-selected == "high";
                            horizontal-stretch: 1;
                            clicked => { root.crossfeed-selected = "high"; root.crossfeed-set("high"); }
                        }
                    }
                }

                Card {
                    title: "Multipoint";
                    enabled: root.gaia-connected;
                    horizontal-stretch: 1;
                    Caption { text: "Current: " + root.multipoint-status-text; }
                    HorizontalLayout {
                        spacing: 8px;
                        Switch {
                            text: root.multipoint-on ? "On" : "Off";
                            checked <=> root.multipoint-on;
                            toggled => { root.multipoint-set(root.multipoint-on); }
                        }
                        Button { text: "Status"; clicked => { root.multipoint-status(); } }
                    }
                }
            }

            Card {
                title: "Paired Devices";
                enabled: root.gaia-connected;
                Caption { text: "Reported by the headset itself (UNVERIFIED opcode) - not this machine's own Bluetooth pairing list."; }
                VerticalLayout {
                    spacing: 6px;
                    for device in root.paired-devices: HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            y: (parent.height - self.height) / 2;
                            background: device.connected ? #4ade80 : #6b7280;
                        }
                        Text { text: device.name; vertical-alignment: center; color: Palette.foreground; }
                    }
                    if root.paired-devices.length == 0: Caption { text: "No data yet - connect and press Refresh."; }
                }
                Button { text: "Refresh"; clicked => { root.refresh-paired-devices(); } }
            }

            Card {
                title: "Device Info";
                enabled: root.gaia-connected;
                Caption { text: root.device-info-text; }
                Button { text: "Refresh"; clicked => { root.refresh-device-info(); } }
            }

            Card {
                title: "More Settings";
                enabled: root.gaia-connected;
                Caption { text: "UNVERIFIED opcodes (third-party protocol writeup) - use with caution."; }
                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            Text { text: "Smart Pause:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.smart-pause-on; toggled => { root.smart-pause-set(root.smart-pause-on); } }
                        }
                        HorizontalLayout {
                            Text { text: "On-Head Detection:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.on-head-detection-on; toggled => { root.on-head-detection-set(root.on-head-detection-on); } }
                        }
                        HorizontalLayout {
                            Text { text: "Auto-Answer:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.auto-answer-on; toggled => { root.auto-answer-set(root.auto-answer-on); } }
                        }
                        HorizontalLayout {
                            Text { text: "Comfort Call:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.comfort-call-on; toggled => { root.comfort-call-set(root.comfort-call-on); } }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            Text { text: "Low Latency:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.low-latency-on; toggled => { root.low-latency-set(root.low-latency-on); } }
                        }
                        HorizontalLayout {
                            Text { text: "BT Compatibility:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.bt-compatibility-on; toggled => { root.bt-compatibility-set(root.bt-compatibility-on); } }
                        }
                        HorizontalLayout {
                            Text { text: "Voice Prompt:"; vertical-alignment: center; color: Palette.foreground; }
                            Rectangle { horizontal-stretch: 1; }
                            Switch { checked <=> root.voice-prompt-on; toggled => { root.voice-prompt-set(root.voice-prompt-on); } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Sidetone:"; vertical-alignment: center; width: 110px; color: Palette.foreground; }
                    Slider {
                        minimum: 0;
                        maximum: 5;
                        value <=> root.sidetone-level;
                        changed(value) => { root.sidetone-set(round(value)); }
                    }
                    Text { text: round(root.sidetone-level); vertical-alignment: center; width: 24px; color: Palette.foreground; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Auto power-off (s):"; vertical-alignment: center; width: 110px; color: Palette.foreground; }
                    Slider {
                        minimum: 0;
                        maximum: 3600;
                        value <=> root.auto-power-off-seconds;
                        changed(value) => { root.auto-power-off-set(round(value)); }
                    }
                    Text { text: round(root.auto-power-off-seconds); vertical-alignment: center; width: 50px; color: Palette.foreground; }
                }
                Button { text: "Refresh All"; clicked => { root.refresh-more-settings(); } }
            }

            Button {
                text: root.advanced-visible ? "Hide Advanced" : "Show Advanced";
                clicked => { root.advanced-visible = !root.advanced-visible; }
            }

            if root.advanced-visible: Card {
                title: "Advanced: raw GAIA command";
                enabled: root.gaia-connected;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Vendor:"; vertical-alignment: center; color: Palette.foreground; }
                    vendor-input := LineEdit { text: "0x0494"; width: 100px; }
                    Text { text: "Command:"; vertical-alignment: center; color: Palette.foreground; }
                    command-input := LineEdit { text: ""; width: 100px; }
                    Text { text: "Payload (hex):"; vertical-alignment: center; color: Palette.foreground; }
                    payload-input := LineEdit { text: ""; width: 140px; }
                    Text { text: "Version:"; vertical-alignment: center; color: Palette.foreground; }
                    version-input := LineEdit { text: "1"; width: 40px; }
                    Button {
                        text: "Send";
                        clicked => {
                            root.raw-gaia-send(vendor-input.text, command-input.text, payload-input.text, version-input.text);
                        }
                    }
                }
            }

            if root.advanced-visible: Card {
                title: "Log";
                height: 220px;
                ScrollView {
                    TextEdit {
                        text: root.log-text;
                        read-only: true;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
